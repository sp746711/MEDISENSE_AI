# MediSense AI — Backend environment template
# Copy to backend/.env and fill in real values.

DATABASE_URL=postgresql+psycopg2://medisense:CHANGE_ME@localhost:5432/medisense_ai
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_NAME=MediSense AI
APP_ENV=development
DEBUG=true
API_PREFIX=/api
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads
XRAY_MODEL_DIR=models/xray
XRAY_DEFAULT_MODEL=chest_resnet18
XRAY_CHEST_CHECKPOINT=
LLM_PROVIDER=groq
LLM_FALLBACK=gemini
LLM_OFFLINE=ollama
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
PROVIDER_DATA_SOURCE=google_places
PROVIDER_API_BASE_URL=https://places.googleapis.com/v1
PROVIDER_API_KEY=

# Google Places API (New) - Doctor & Provider Discovery
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1
GOOGLE_PLACES_PAGE_SIZE=10
GOOGLE_PLACES_RADIUS_KM=25

FACILITY_DATA_SOURCE=
FACILITY_API_BASE_URL=
FACILITY_API_KEY=

MEDICAL_SHOP_DATA_SOURCE=
MEDICAL_SHOP_API_BASE_URL=
MEDICAL_SHOP_API_KEY=

PROVIDER_PAGE_SIZE=10
FACILITY_PAGE_SIZE=10
MEDICAL_SHOP_PAGE_SIZE=10

LOCAL_RADIUS_KM=25
EXPANDED_RADIUS_KM=50

MAP_DEFAULT_ZOOM=13

# Geoapify Places API (Nearby Hospital & Medical Shop discovery)
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com/v2/places
GEOAPIFY_FACILITY_CATEGORY=healthcare.hospital
GEOAPIFY_MEDICAL_SHOP_CATEGORY=healthcare.pharmacy
GEOAPIFY_DEFAULT_RADIUS_KM=25
GEOAPIFY_EXPANDED_RADIUS_KM=50
GEOAPIFY_PAGE_SIZE=10
GEOAPIFY_TIMEOUT_SECONDS=10

