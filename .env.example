# MediSense AI — Environment Configuration Template
# Copy to .env (repo root) and/or backend/.env and frontend/.env
# NEVER commit real secrets.

# ── Database (PostgreSQL) ──────────────────────────────────────────
DATABASE_URL=postgresql+psycopg2://medisense:CHANGE_ME@localhost:5432/medisense_ai

# ── Security / JWT ─────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ── CORS (comma-separated origins) ─────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── App ────────────────────────────────────────────────────────────
APP_NAME=MediSense AI
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# ── File uploads ───────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads

# ── X-ray models ───────────────────────────────────────────────────
XRAY_MODEL_DIR=models/xray
XRAY_DEFAULT_MODEL=chest_resnet18
# Leave empty until a trained checkpoint is placed on disk
XRAY_CHEST_CHECKPOINT=

# ── LLM providers (never hard-code keys) ───────────────────────────
LLM_PROVIDER=groq
LLM_FALLBACK=gemini
LLM_OFFLINE=ollama
GROQ_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Provider / facility data sources ───────────────────────────────
# Leave empty until a legitimate authorized source is configured
PROVIDER_DATA_SOURCE=
FACILITY_DATA_SOURCE=
MEDICAL_SHOP_DATA_SOURCE=

# ── Frontend (Vite) ────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api
